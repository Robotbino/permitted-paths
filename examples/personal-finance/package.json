{
  "name": "personal-finance-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Reference application of the Practical Architecture Studio (Permitted Paths). Fictional data only.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=.env server/main.ts",
    "dev:web": "vite",
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "start": "tsx --env-file-if-exists=.env server/main.ts",
    "record-runs": "tsx scripts/record-runs.ts",
    "record-runs:check": "tsx scripts/record-runs.ts --check",
    "check": "npm run typecheck && npm test && npm run record-runs:check"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^3.2.7"
  }
}
