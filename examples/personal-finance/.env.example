# Copy this file to .env. Git ignores .env. Never put a real key in a file that git tracks,
# and never in the web application: all that a browser gets, a person can read.

# Optional. Without a key the AI is off and the application works the same.
# Make the key in the Claude Console, in a workspace of its own with a low spend limit.
ANTHROPIC_API_KEY=

# Optional settings, with their default values.
# AI_MODEL=claude-haiku-5-5
# AI_TIMEOUT_MS=4000
# AI_DAILY_CAP=50
# PORT=8787
# DB_FILE=data/finance.sqlite
