      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Makes one task from one Telegram message. Code selects the repository and the mode. No model is used.\n// REPOS: a name that can be in a message -> the key of the repository in the config of the bridge.\nconst REPOS = { 'employee manager': 'employee-manager', 'employee-manager': 'employee-manager' };\nconst msg = $input.first().json.message;\nconst text = (msg.text || '').trim();\nlet mode = 'investigate', repo = '', prompt = text;\nif (/^\\/ask\\b/i.test(text)) { mode = 'ask'; repo = 'vault'; prompt = text.replace(/^\\/ask\\s*/i, ''); }\nelse { const lower = text.toLowerCase(); for (const name of Object.keys(REPOS)) { if (lower.includes(name)) { repo = REPOS[name]; break; } } }\nconst id = 't-' + Date.now().toString(36).slice(-4) + Math.random().toString(36).slice(2, 6);\nreturn [{ json: { task_id: id, user_id: String(msg.from.id), chat_id: msg.chat.id, repo, mode, prompt } }];"
      },
